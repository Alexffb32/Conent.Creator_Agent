# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mesa: segredo para assinar tokens (gerar com: openssl rand -hex 32) ---
TABLE_TOKEN_SECRET=

# --- Jobs (Vercel Cron envia Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- Web Push (gerar com: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ola@provei.pt

# --- E-mail (opcional; sem chave, os e-mails vão para a consola) ---
RESEND_API_KEY=
RESEND_FROM=Provei <onboarding@resend.dev>
MAIL_FROM=Provei <onboarding@resend.dev>

# --- Pagamentos Stripe (modo de teste; atrás da flag `payments`) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INSTALL=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_AD_FREE=

# --- Login com Google (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Wallet (opcional; atrás da flag `wallet`) ---
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_BASE64=
APPLE_PASS_CERT_PASSWORD=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# --- Vídeo: local | mux | cloudflare ---
VIDEO_PROCESSOR=local
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- Rate limiting (opcional; sem Redis usa Postgres e depois memória) ---
RATE_LIMIT_REDIS_URL=

# --- Só para scripts (opcional) ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# --- Valores públicos (apresentação; os preços reais ficam na Stripe) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_GOOGLE_AUTH=false
NEXT_PUBLIC_PRICE_INSTALL_EUR=490
NEXT_PUBLIC_PRICE_MONTHLY_EUR=99
NEXT_PUBLIC_PRICE_AD_FREE_EUR=2.99
ACCOUNT_RETENTION_DAYS=30
